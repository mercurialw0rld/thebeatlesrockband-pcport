diff --git a/include/rex/ui/d3d12/timing_trace.h b/include/rex/ui/d3d12/timing_trace.h
new file mode 100644
index 0000000..452cb47
--- /dev/null
+++ b/include/rex/ui/d3d12/timing_trace.h
@@ -0,0 +1,41 @@
+// Optional host timing telemetry. Each channel has one producer; a separate
+// process persists the ring. No file I/O, allocation, or logs in the hot path.
+#pragma once
+#include <windows.h>
+#include <atomic>
+#include <cstdint>
+#include <cstddef>
+#include <new>
+#include <rex/cvar.h>
+REXCVAR_DECLARE(bool, trace_gpu_timing);
+namespace rex::ui::d3d12::timing {
+inline std::int64_t Now() { LARGE_INTEGER q; QueryPerformanceCounter(&q); return q.QuadPart; }
+struct Sample { std::int64_t start, ready, submit_begin, submit_end, present_begin, end; };
+class Ring {
+  static constexpr unsigned kCapacity=8192;
+  struct Shared {
+    std::uint32_t magic=0x42524754,version=1;
+    std::int64_t frequency=0;
+    std::atomic<std::uint32_t> committed{0};
+    std::uint32_t capacity=kCapacity,producer=0,reserved=0;
+    Sample samples[kCapacity]{};
+  };
+  static_assert(offsetof(Shared,samples)==32);
+  HANDLE handle_=nullptr;
+  Shared* data_=nullptr;
+ public:
+  explicit Ring(const wchar_t* channel) {
+    wchar_t name[128]; swprintf_s(name,L"Local\\BeatlesPort.%s.%lu",channel,GetCurrentProcessId());
+    handle_=CreateFileMappingW(INVALID_HANDLE_VALUE,nullptr,PAGE_READWRITE,0,sizeof(Shared),name);
+    if(handle_) data_=static_cast<Shared*>(MapViewOfFile(handle_,FILE_MAP_ALL_ACCESS,0,0,sizeof(Shared)));
+    if(data_){ new(data_) Shared; LARGE_INTEGER f; QueryPerformanceFrequency(&f); data_->frequency=f.QuadPart; data_->producer=GetCurrentThreadId(); }
+  }
+  ~Ring(){ if(data_)UnmapViewOfFile(data_); if(handle_)CloseHandle(handle_); }
+  void Record(const Sample& sample){
+    if(!data_)return;
+    auto n=data_->committed.load(std::memory_order_relaxed);
+    data_->samples[n%kCapacity]=sample;
+    data_->committed.store(n+1,std::memory_order_release);
+  }
+};
+} // namespace rex::ui::d3d12::timing
