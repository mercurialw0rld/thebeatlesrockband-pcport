diff --git a/include/rex/graphics/precise_wait.h b/include/rex/graphics/precise_wait.h
new file mode 100644
index 0000000..e31f9c1
--- /dev/null
+++ b/include/rex/graphics/precise_wait.h
@@ -0,0 +1,25 @@
+#pragma once
+#include <chrono>
+#include <rex/thread.h>
+#if defined(_WIN32)
+#include <windows.h>
+#endif
+namespace rex::graphics {
+// Keep sub-millisecond waits real on Windows. thread::Sleep truncates these
+// to Sleep(0), which can busy-poll and compete with the audio producer.
+inline void PreciseGpuWait(std::chrono::microseconds duration) {
+#if defined(_WIN32)
+  struct Timer {
+    HANDLE handle=CreateWaitableTimerExW(nullptr,nullptr,CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,TIMER_MODIFY_STATE|SYNCHRONIZE);
+    ~Timer(){if(handle)CloseHandle(handle);}
+  };
+  thread_local Timer timer;
+  LARGE_INTEGER due; due.QuadPart=-duration.count()*10;
+  if(timer.handle && SetWaitableTimerEx(timer.handle,&due,0,nullptr,nullptr,nullptr,0) &&
+      WaitForSingleObject(timer.handle,INFINITE)==WAIT_OBJECT_0)return;
+  ::Sleep(DWORD((duration.count()+999)/1000));
+#else
+  rex::thread::Sleep(duration);
+#endif
+}
+}
